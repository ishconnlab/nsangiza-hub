# Frontend build-time environment (Vite). Copy to `.env` for local overrides.
# Only variables prefixed with VITE_ are exposed to the browser.

# Base URL of the API. Leave empty in local dev to use the Vite proxy (/api/v1).
# In production set the full Render URL including the /api/v1 prefix.
VITE_API_BASE_URL=https://nsangiza-hub.onrender.com/api/v1

# Public origin of this frontend. Used to build canonical URLs, Open Graph
# tags and sitemap.xml at build time.
VITE_SITE_URL=https://your-frontend.vercel.app

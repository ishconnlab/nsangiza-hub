# Frontend build-time environment (Vite). Copy to `.env` for local overrides.
# Only variables prefixed with VITE_ are exposed to the browser.

# Base URL of the API (Render).
VITE_API_BASE_URL=https://nsangiza-hub.onrender.com/api/v1

# Public origin of this frontend (Vercel). Used to build canonical URLs,
# Open Graph tags and sitemap.xml at build time.
VITE_SITE_URL=https://nsangizahub.vercel.app

# Nsangiza Hub — API server environment
NODE_ENV=development
PORT=4000

# Local MongoDB (default uri shown)
MONGODB_URI=mongodb://127.0.0.1:27017/nsangiza_hub

# Auth secrets — REPLACE in every deployed environment.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated allowed origins (Vite dev default)
CLIENT_ORIGIN=http://localhost:5173
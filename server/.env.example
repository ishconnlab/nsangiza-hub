# Nsangiza Hub - API server environment
# Copy to `.env` and fill in real values. Never commit the real `.env`.

NODE_ENV=development
PORT=4000

# Database. Local dev defaults to a local MongoDB; production requires this.
# Local:     mongodb://127.0.0.1:27017/nsangiza_hub
# Atlas:     mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nsangiza_hub?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nsangiza_hub

# Optional. Forces the database name; defaults to the URI path, or "nsangiza_hub".
# Set this if your MONGODB_URI does not include a database name.
# MONGODB_DB_NAME=nsangiza_hub

# Auth secrets - REPLACE with long random values in every deployed environment.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated allowed frontend origins (CORS allowlist).
# Dev:  http://localhost:5173
# Prod: https://your-frontend.vercel.app,https://your-domain.com
CLIENT_ORIGIN=http://localhost:5173

# Refresh-cookie policy. When the frontend and API are on different sites
# (e.g. Vercel + Render) these MUST be:
#   COOKIE_SAME_SITE=none
#   COOKIE_SECURE=true
# In local development leave them unset (defaults: lax / false in non-prod).
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
# Optional: set to share the cookie across subdomains (e.g. .your-domain.com).
# COOKIE_DOMAIN=
